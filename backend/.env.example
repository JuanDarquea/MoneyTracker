# Production/Staging: Supabase Postgres connection
# Format: postgresql+psycopg://postgres:<your-db-password>@db.<project-ref>.supabase.co:5432/postgres
# Replace <your-db-password> with the password you set during Supabase project creation
# For this project (obcdryzanpsocsurqatv), the URL should be:
# postgresql+psycopg://postgres:YOUR_PASSWORD@db.obcdryzanpsocsurqatv.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:YOUR_SUPABASE_DB_PASSWORD@db.obcdryzanpsocsurqatv.supabase.co:5432/postgres

