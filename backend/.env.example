# Production/Staging: Supabase Postgres connection
# Format: postgresql+psycopg://postgres:<your-db-password>@db.<project-ref>.supabase.co:5432/postgres
# Replace <project-ref> with your Supabase project ref and <your-db-password> with the
# database password you set during Supabase project creation (resettable via the dashboard).
DATABASE_URL=postgresql+psycopg://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Testing: Local Docker Postgres (isolated test database)
TEST_DATABASE_URL=postgresql+psycopg://moneytracker:moneytracker@localhost:5433/moneytracker_test

# Supabase Configuration
# Project Settings > API > Project URL / anon (public) key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# JWT Configuration for Supabase Auth
# Secret used to sign JWTs (Project Settings > Auth > JWT Settings) — never commit the real value
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
# JWT audience claim (standardized for Supabase)
SUPABASE_JWT_AUD=authenticated
